{
  "name": "raw-desktop-events",
  "version": "0.1.0",
  "exports": "./mod.ts",
  "license": "MIT",
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-ffi --allow-run --allow-env",
    "dev": "deno test --watch --allow-read --allow-write --allow-ffi --allow-run --allow-env",
    "build:native": "deno run --allow-run --allow-read --allow-write --allow-env tools/build.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "unstable": ["ffi"],
  "compilerOptions": {
    "lib": ["deno.window", "deno.unstable"]
  },
  "publish": {
    "include": [
      "mod.ts",
      "src/**/*.ts",
      "native/**",
      "tools/build.ts",
      "README.md",
      "LICENSE",
      "deno.json"
    ],
    "exclude": [
      "**/*_test.ts",
      "examples/**"
    ]
  }
}
