{
  "name": "raw-desktop-events",
  "version": "0.1.0",
  "exports": {
    ".": "./mod.ts",
    "./macos": "./src/platforms/macos.ts",
    "./windows": "./src/platforms/windows.ts",
    "./linux": "./src/platforms/linux.ts"
  },
  "license": "MIT",
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-ffi --allow-run --allow-env tests/",
    "dev": "deno test --watch --allow-read --allow-write --allow-ffi --allow-run --allow-env tests/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno lint && deno fmt --check && deno test --allow-read --allow-write --allow-ffi --allow-run --allow-env tests/",
    "build:native": "deno run --allow-run --allow-read --allow-write --allow-env tools/build.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "unstable": ["ffi"],
  "compilerOptions": {
    "lib": ["deno.window", "deno.unstable"]
  },
  "publish": {
    "include": [
      "mod.ts",
      "src/**/*.ts",
      "native/**",
      "tools/build.ts",
      "README.md",
      "LICENSE",
      "deno.json"
    ],
    "exclude": [
      "tests/**",
      "examples/**"
    ]
  }
}
